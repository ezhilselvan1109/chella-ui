{
  "name": "chellaa-ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chellaa UI - Enterprise NPM Workspaces Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:docs": "npm run dev --workspace=@chellaa/docs",
    "dev:playground": "npm run dev --workspace=@chellaa/playground",
    "dev:consumer": "npm run dev --workspace=@chellaa/test-consumer",
    "storybook": "npm run storybook --workspace=@chellaa/storybook",
    "build:storybook": "npm run build:storybook --workspace=@chellaa/storybook",
    "build:ui": "npm run build --workspace=@chellaa/ui",
    "build:docs": "npm run build --workspace=@chellaa/docs",
    "build:playground": "npm run build --workspace=@chellaa/playground",
    "build:consumer": "npm run build --workspace=@chellaa/test-consumer",
    "build:all": "npm run build:ui && npm run build:docs && npm run build:playground && npm run build:storybook && npm run build:consumer",
    "build": "npm run build:docs",
    "vercel-build": "npm run build:ui && npm run build:docs",
    "test": "npm run test --workspace=@chellaa/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@rollup/rollup-linux-x64-musl": "^4.62.4"
  }
}
